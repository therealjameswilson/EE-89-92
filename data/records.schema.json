{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRUS Eastern Europe Compiler Cue",
  "type": "object",
  "required": [
    "id",
    "date",
    "sortDate",
    "type",
    "title",
    "countries",
    "chapter",
    "status",
    "sourceFamily",
    "sourceNote",
    "nextAction",
    "topics"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable local identifier, preferably country-date-topic."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "sortDate": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": ["Memcon", "Telcon"]
    },
    "title": {
      "type": "string"
    },
    "dateLine": {
      "type": "string"
    },
    "subjectLine": {
      "type": "string"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chapter": {
      "type": "object",
      "required": ["number", "name"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "name": {
          "type": "string",
          "enum": [
            "Poland",
            "Hungary",
            "Czechoslovakia",
            "Bulgaria",
            "Romania",
            "Albania",
            "Yugoslavia",
            "Slovenia",
            "Croatia",
            "Bosnia and Herzegovina",
            "Serbia and Montenegro",
            "Estonia",
            "Latvia",
            "Lithuania",
            "Ukraine"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["Document found"]
    },
    "releaseStatus": {
      "type": "string",
      "enum": ["Full", "Partial"]
    },
    "coverageRole": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "naid": {
      "type": "string"
    },
    "catalogUrl": {
      "type": "string",
      "format": "uri-reference"
    },
    "pdfUrl": {
      "type": "string",
      "format": "uri-reference"
    },
    "sourceFamily": {
      "type": "string"
    },
    "pageCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of pages in the linked official PDF scan for this declassified memcon or telcon."
    },
    "sourceNote": {
      "type": "string"
    },
    "nextAction": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      }
    }
  }
}
